# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email Configuration (Optional - for contact forms)
GMAIL_USER=your_gmail_address
GMAIL_APP_PASSWORD=your_gmail_app_password
ADMIN_EMAIL=admin_notification_email

# Google reCAPTCHA v3 (Optional - for form protection)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# AbstractAPI Email Validation (REQUIRED for registration security)
# Get your API key from: https://www.abstractapi.com/api/email-verification-validation-api
# Free tier: 100 requests/month, upgrade for more
NEXT_PUBLIC_ABSTRACT_API_KEY=your_abstract_api_key

# HaveIBeenPwned Password Breach Check
# No API key required - uses k-anonymity model for privacy
# Automatically checks if passwords have been compromised in data breaches

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Sentry Error Tracking (Optional)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Environment
NODE_ENV=production
